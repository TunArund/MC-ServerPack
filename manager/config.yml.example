host: manageraddr
user: manageruser
dir: /home/manageruser/MC-ServerPack-manager
auto-stop: false
stop-at: '23:05'
region: ap-nanjing
instance-id: ins-xxxxyyyy
modpack:
  auto-stop: false
  stop-at: '23:00'
  stop-notify-elast: 60
  stop-notify-step: 2
  java:
  - 8
  - 17
  - 21
  max-running: 1
  mem-limit: 16g
  start-timeout: 300
  stop-timeout: 180
