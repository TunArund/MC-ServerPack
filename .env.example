# manager服务器的腾讯云 API 密钥，用于定时开关机
# 需要先在腾讯云控制台创建 仅编程访问 并且 有如下权限 的子用户
# 然后创建API密钥
# "cvm:DescribeInstances",
# "cvm:StartInstances",
# "cvm:StopInstances",
# 详细说明看readme.md的 腾讯云编程子用户
POWER_SECRET_ID=
POWER_SECRET_KEY=

# power-api.provider=webhook 时使用，作为 Bearer Token 发送
POWER_API_TOKEN=

# qq机器人的api密钥
# 在这里登qq号 https://q.qq.com 然后创建机器人 https://q.qq.com/qqbot/dashboard/
# 创建机器人后在 开发设置 中获取AppID与AppSecret
QQBOT_APP_ID=
QQBOT_APP_KEY=

# 对象存储桶密钥，配置与POWER类似，不过这里需要cos上传下载权限
COS_SECRET_ID=
COS_SECRET_KEY=
