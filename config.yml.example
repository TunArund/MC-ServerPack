# 核心服务器
manager:
  host: manageraddr
  user: manageruser
  dir: /home/manageruser/MC-ServerPack-manager
  java: [8, 17, 21]
  max-running: 1
  mem-limit: 16g
  start-timeout: 300
  stop-timeout: 180
  schedule:
    auto-stop: false
    stop-at: '23:00'
    notify-elast: 60
    notify-step: 2
    poweroff:
      enabled: false
      deadline: 5
      region: ap-nanjing
      instance-id: ins-xxxxyyyy

# 7x24h监控，可选开启，开启后可设置定时开机、manager监控告警、qq消息控制
monitor:
  enabled: false
  host: monitoraddr
  user: monitoruser
  dir: /home/monitoruser/MC-ServerPack-monitor
  manager:
    region: ap-nanjing
    instance-id: ins-xxxxyyyy
    # 定时开机
    auto-start: true
    start-at: '19:55'  # 开机时间
    # 定时关机（可同时开启，作为二次检查）
    auto-stop: true    # 自动关机
    stop-at: '23:05'   # 关机时间
  qqbot:
    targets:
    - type: user
      id: aaa
    # 只有群主才能邀请机器人进群
    - type: group
      id: bbb
    admins:
    - aaa

# 可选的对象存储，开启后可配置云端备份（当网盘用）
cos:
  enabled: false
  region: ap-shanghai
  bucket: bucketname-appid
  prefix: /minecraft
  expire: 3600
