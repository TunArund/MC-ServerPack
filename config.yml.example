# 核心管理端
manager:
  host: hostaddr
  user: username
  dir: /home/username/MC-ServerPack/manager
  # 以下均可省略：默认同时运行 1 个、超限拒绝、不设全局内存上限。
  modpack:
    max-running: 1
    overnum-action: rotate
    mem-limit: 13g
    start-timeout: 5m
    stop-timeout: 3m


# 可选的gateway，设置后可以自动开关机
gateway:
  host: hostaddr
  user: username
  dir: /home/steam/MC-ServerPack/qqbot
  region: ap-nanjing
  instance-id: ins-xxxxyyyy
  schedule:
    enabled: true
    start: 20:00
    start-elast: 5
    end: 23:00
    end-elast: 3
    notify-elast: 60
    notify-step: 2
  qqbot:
    targets:
    - type: user
      id: aaa
    # 只有群主才能邀请机器人进群
    - type: group
      id: bbb
    admins:
    - aaa
    
# 可选的对象存储
cos:
  region: ap-shanghai
  bucket: bucketname-appid
  prefix: /minecraft
  expire: 3600
