# 核心服务器
manager:
  host: manageraddr
  user: manageruser
  dir: /home/manageruser/MC-ServerPack-manager
  # 定时关闭云主机
  auto-stop: false
  stop-at: '23:05'
  power-api:
    provider: tencent
    instance-id: ins-xxxxyyyy
    instance-region: ap-nanjing
    url: null
  modpack:
    # 定时停止全部整合包；应早于云主机关机时间
    auto-stop: false
    stop-at: '23:00'
    stop-notify-elast: 60
    stop-notify-step: 2
    java: [8, 17, 21]
    max-running: 1
    mem-limit: 16g
    start-timeout: 300
    stop-timeout: 180

# 7x24h监控，可选开启，开启后可设置定时开机、manager监控告警、qq消息控制
monitor:
  enabled: false
  host: monitoraddr
  user: monitoruser
  dir: /home/monitoruser/MC-ServerPack-monitor
  manager:
    power-api:
      provider: tencent
      instance-id: ins-xxxxyyyy
      instance-region: ap-nanjing
      url: null
    # 定时开机
    auto-start: true
    start-at: '19:55'  # 开机时间
    # 定时关机（可同时开启，作为二次检查）
    auto-stop: true    # 自动关机
    stop-at: '23:05'   # 关机时间
  qqbot:
    targets:
    - type: user
      id: aaa
    # 只有群主才能邀请机器人进群
    - type: group
      id: bbb
    admins:
    - aaa

# 可选的对象存储，开启后可配置云端备份（当网盘用）
cos:
  enabled: false
  region: ap-shanghai
  bucket: bucketname-appid
  prefix: /minecraft
  expire: 3600
