# 核心服务器
manager:
  host: manageraddr
  user: manageruser
  dir: /home/manageruser/MC-ServerPack-manager
  timezone: Asia/Shanghai
  api:
    listen: 0.0.0.0
    port: 27016
  # 定时关机
  auto-stop: false
  stop-at: '23:05'
  power-api:
    provider: tencent
    instance-id: ins-xxxxyyyy
    instance-region: ap-nanjing
  modpack:
    # 定时关服
    auto-stop: false
    stop-at: '23:00'
    stop-notify-elast: 60
    stop-notify-step: 2
    # 环境配置
    java: [8, 17, 21]
    max-running: 1
    mem-limit: 16g
    start-timeout: 300
    stop-timeout: 180

# 7x24h监控，可选开启，开启后可设置定时开机、监控告警、qq机器人
monitor:
  enabled: false
  host: monitoraddr
  user: monitoruser
  dir: /home/monitoruser/MC-ServerPack-monitor
  timezone: Asia/Shanghai
  manager:
    power-api:
      provider: tencent
      instance-id: ins-xxxxyyyy
      instance-region: ap-nanjing
    # monitor 段保持完整，可整段复制到独立 Monitor 的 config.yml。
    # 这里的 host 故意与 manager.host 重复，端口与 manager.api.port 重复。
    api:
      host: manageraddr
      port: 27016
    # 定时开机
    auto-start: true
    start-at: '19:55'  # 开机时间
    # 定时关机（可同时开启，作为二次检查）
    auto-stop: true    # 自动关机
    stop-at: '23:05'   # 关机时间
    # 通知目标的添加参考readme.md
# 可选的对象存储，开启后可配置云端备份（当网盘用）
cos:
  enabled: false
  region: ap-shanghai
  bucket: bucketname-appid
  prefix: /minecraft
  expire: 3600
